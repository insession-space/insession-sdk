{
  // @insession/space-state は transport/フレームワーク非依存の純粋 TS（DOM にも React にも依存しない）。
  // tsc は型検査専用（noEmit）。配布物(dist)の生成は tsup が行う（tsup.config.ts）。
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
